# 修改时间：2026-09-07 | 文件说明：VaultAgent 本地开发环境变量名称模板 | edit by：Sliye
# 密钥只写入已忽略的 .env.local；运行 `vercel env pull .env.local --environment development --yes` 获取 Vercel 变量。
AI_GATEWAY_API_KEY=

# `docker compose up -d` 使用 compose.yaml 中仅限本地开发的数据库凭据。
DATABASE_URL=postgres://vaultagent:vaultagent_dev@localhost:5433/vaultagent
APP_MODE=local
DATA_DIR=./data
STORAGE_PROVIDER=filesystem
# Preview 私有 Blob 验证时设置为 blob；Vercel 运行时使用项目已连接的私有 Blob OIDC/BLOB_STORE_ID。
BLOB_STORE_ID=
# 仅 APP_MODE=preview 的受保护验证请求使用；不要暴露到浏览器或提交真实值。
PREVIEW_UPLOAD_TOKEN=
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
WORKFLOW_POSTGRES_URL=postgres://vaultagent:vaultagent_dev@localhost:5433/vaultagent
