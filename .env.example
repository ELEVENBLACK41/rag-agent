# 修改时间：2026-09-17 | 文件说明：VaultAgent 本地开发与所有者管理环境变量模板 | edit by：Sliye
# 密钥只写入已忽略的 .env.local；运行 `vercel env pull .env.local --environment development --yes` 获取 Vercel 变量。
AI_GATEWAY_API_KEY=

# `docker compose up -d` 使用 compose.yaml 中仅限本地开发的数据库凭据。
DATABASE_URL=postgres://vaultagent:vaultagent_dev@localhost:5433/vaultagent
APP_MODE=local
DATA_DIR=./data
STORAGE_PROVIDER=filesystem
# Preview 私有 Blob 使用时设置为 blob；Vercel 运行时使用项目已连接的私有 Blob OIDC/BLOB_STORE_ID。
BLOB_STORE_ID=
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
WORKFLOW_POSTGRES_URL=postgres://vaultagent:vaultagent_dev@localhost:5433/vaultagent

# Auth.js GitHub OAuth；回调地址为 http://localhost:3000/api/auth/callback/github。
# 正式站使用 HTTPS；OWNER_GITHUB_ID 是数字用户 ID，不是可修改的用户名。
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
OWNER_GITHUB_ID=
# 本地可填写部署的 Git commit；未配置明确显示未知，不猜测历史版本。
APP_CODE_VERSION=
